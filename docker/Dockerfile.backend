FROM python:3.12-slim

WORKDIR /app

# Copy local offline Debian packages for libgomp1 and its dependency
COPY docker/packages/gcc-12-base_12.2.0-14+deb12u1_amd64.deb /tmp/gcc-12-base.deb
COPY docker/packages/libgomp1_12.2.0-14+deb12u1_amd64.deb /tmp/libgomp1.deb

# Install system dependencies offline
RUN dpkg -i /tmp/gcc-12-base.deb /tmp/libgomp1.deb && rm -f /tmp/*.deb

# Copy project files (respecting .dockerignore)
COPY . /app

# Set PYTHONPATH to use the host/pre-installed .venv site-packages inside container
ENV PYTHONPATH=/app

EXPOSE 8000

# Run uvicorn pointing to python module directly
CMD ["python3", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
